# Optional local settings. Copy to .env (git-ignored) and uncomment what you need.
# Read by the artha CLI (./artha, .\artha.ps1), `npm run dev:*`, scripts/backend.mjs,
# frontend/vite.config.mts and the Electron app in dev mode, so every entry point agrees.

# Backend (FastAPI) and frontend (Vite) dev ports. Default 8010/5183 on every OS
# (not 8000, which the packaged desktop app uses, or other projects' common ports).
# ARTHA_BACKEND_PORT=8010
# ARTHA_FRONTEND_PORT=5183

# Docker/web deployment host ports (docker-compose.yml also reads this file).
# ARTHA_BACKEND_HOST_PORT=8000
# ARTHA_FRONTEND_HOST_PORT=8080
