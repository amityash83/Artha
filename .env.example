# Optional local settings. Copy to .env (git-ignored) and uncomment what you need.
# Read by ./start.sh, `npm run dev:*`, scripts/backend.mjs, frontend/vite.config.mts
# and the Electron app in dev mode, so every entry point agrees on the ports.

# Backend (FastAPI) and frontend (Vite) dev ports. Defaults: 8000/5173 for npm scripts,
# 8010/5183 for ./start.sh (chosen to avoid clashing with other local projects).
# ARTHA_BACKEND_PORT=8010
# ARTHA_FRONTEND_PORT=5183

# Docker/web deployment host ports (docker-compose.yml also reads this file).
# ARTHA_BACKEND_HOST_PORT=8000
# ARTHA_FRONTEND_HOST_PORT=8080
